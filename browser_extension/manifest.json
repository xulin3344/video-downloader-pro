{
  "manifest_version": 3,
  "name": "万能网页视频嗅探与下载器 Pro",
  "version": "1.0.0",
  "description": "实时智能嗅探当前网页中的各类流媒体 (MP4/M3U8/FLV/WebM/DPlayer/抖音/B站/各类影视)，支持动态视讯略缩演示、M3U8多线程合并与桌面端一键秒传。",
  "permissions": [
    "webRequest",
    "downloads",
    "tabs",
    "activeTab",
    "storage",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "万能视频嗅探器 Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injected_sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
